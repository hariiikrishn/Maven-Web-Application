pipeline{
    agent any;
    tools{
        maven 'maven3.9.10'
    }
    parameters {
        choice (
            name:'branch',choices:["development","main"], description:"select the branch to clone"
        )
    }
    stages{
        stage('checkout code'){
            steps{
              git branch:"${params.branch}", url:'https://github.com/hariiikrishn/Maven-Web-Application.git'
            }
        }
        stage('build'){
            steps{
                sh 'mvn clean package'
            }
        }
        stage('build docker image'){
            steps{
              sh 'docker build -t rachhit/maven-web-application:1 .'
            }
        }
        stage('push docker image'){
            steps{
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]){
                    sh '''
                       echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                       docker push rachhit/maven-web-application:1
                    '''
                }
            }
    }
  stage('deploy to other server'){
                steps{
                    sshagent(['deploy-server-ssh']){
                         sh '''
                            ssh -o StrictHostKeyChecking=no ubuntu@3.111.35.235 "
                            docker pull rachhit/maven-web-application:1 &&
                            docker stop maven-web-app || true &&
                            docker rm maven-web-app || true &&
                            docker run -d \
                           --name maven-web-app \
                           -p 8080:8080 \
                           --restart unless-stopped \
                           rachhit/maven-web-application:1
                          "
                         '''
                    }
                }
            }
}
}
